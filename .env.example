APP_NAME="Mahalo Immobilier"
APP_DEBUG=false
APP_ENV=production
APP_URL=https://api.mahalo.ma
APP_KEY=

LOG_CHANNEL=daily

BROADCAST_DRIVER=log
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=true
ENABLE_HTTP_SECURITY_HEADERS=true

# ─── Database (Hostinger MySQL) ───────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
DB_STRICT=false

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_DIR=admin

# ─── API ──────────────────────────────────────────────────────────────────────
CMS_ENABLE_INSTALLER=false

# ─── CORS (allow your frontend domain) ───────────────────────────────────────
FRONTEND_URL=https://mahalo.ma

# ─── Mail (SMTP - use Hostinger email or other provider) ────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=your-email@your-domain.com
MAIL_PASSWORD=your-email-password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=your-email@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# ─── SSL (uncomment after enabling SSL on Hostinger) ─────────────────────────
FORCE_SCHEMA=https
FORCE_ROOT_URL=https://blueviolet-newt-360669.hostingersite.com
