# ─── LOCAL DEVELOPMENT ────────────────────────────────────────────────────────
# Leave VITE_API_URL empty. The Vite dev server proxies /api and /storage to
# https://api.mahalo.ma automatically (see vite.config.js).
# Setting it to the full URL causes the browser to call api.mahalo.ma directly,
# which will fail with a CORS error.
VITE_API_URL=

# ─── PRODUCTION BUILD (no proxy) ──────────────────────────────────────────────
# Only set this if you are building a static bundle served WITHOUT a Vite proxy
# (e.g. nginx, CDN). In that case the backend must allow your origin in CORS.
# VITE_API_URL=https://api.mahalo.ma
